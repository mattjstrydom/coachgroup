# Copy this file to .env.local and fill in your SMTP credentials.
# Any SMTP provider works (Gmail, Outlook, your hosting provider, etc.)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# Where enquiries are sent (defaults to info@coachgroup.co.za if unset)
CONTACT_EMAIL=info@coachgroup.co.za
